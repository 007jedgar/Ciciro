# Local development only. EAS builds, updates and workflows never read this
# file: they use EAS environment variables (development, preview,
# production). `eas env:pull --environment development` writes a .env from
# them. Which variables exist, per environment and visibility, is in
# ../../docs/mobile-release.md#environment-variables.
#
# Everything EXPO_PUBLIC_ is compiled into the app and readable by anyone who
# has it. Never put a secret here (ANTHROPIC_API_KEY stays on the server).

# Origin of hosted Ciciro (no trailing slash). See ../../docs/setup-accounts.md
EXPO_PUBLIC_API_URL=http://localhost:3000

# Optional. RevenueCat public SDK keys; without one the app sells nothing and
# shows no paywall. See ../../docs/billing.md#revenuecat
# EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=
# EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=
# Development builds only: show the paywall with sample prices and no key.
# A preview or production build refuses to bundle with it set.
# EXPO_PUBLIC_BILLING_PREVIEW=1
