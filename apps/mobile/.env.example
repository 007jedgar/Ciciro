# Origin of hosted Ciciro (no trailing slash). Never put ANTHROPIC_API_KEY here.
# See ../../docs/setup-accounts.md
EXPO_PUBLIC_API_URL=http://localhost:3000

# Optional. RevenueCat public SDK keys; without one the app sells nothing and
# shows no paywall. See ../../docs/billing.md#revenuecat
# EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=
# EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=
# Development builds only: show the paywall with sample prices and no key.
# EXPO_PUBLIC_BILLING_PREVIEW=1
