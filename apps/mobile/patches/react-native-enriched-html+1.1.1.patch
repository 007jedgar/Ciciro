+#import <UIKit/UIKit.h>
+
+// Where one screenplay element sits on the page, in columns of the editor's
+// monospace face.
+@interface ScreenplayElementMetrics : NSObject
+@property(nonatomic, assign) CGFloat indent;
+@property(nonatomic, assign) CGFloat width;
+@property(nonatomic, assign) BOOL alignRight;
+@property(nonatomic, assign) BOOL caps;
+@end
+
+// What the app tells the editor about the page (the `screenplay` prop, JSON):
+// the page's width in columns, each element's metrics, what Return starts after
+// each element, and which element pairs sit with no blank line between them.
+// The numbers belong to the app's shared screenplay engine; the editor holds no
+// page rules of its own.
+@interface ScreenplayConfig : NSObject
+@property(nonatomic, readonly) CGFloat columns;
++ (instancetype _Nullable)configFromJson:(NSString *_Nullable)json;
+// Metrics for `tag`; a tag this config does not know lays out as action.
+- (ScreenplayElementMetrics *_Nonnull)metricsForTag:(NSString *_Nullable)tag;
+// The element a new paragraph takes when Return ends one tagged `tag`.
+- (NSString *_Nonnull)tagAfterEnterFrom:(NSString *_Nullable)tag;
+/// Whether the app's layout lists `tag` (a tag only a newer client writes is laid out as action but never rewritten).
+- (BOOL)knowsTag:(NSString *_Nullable)tag;
+// Whether `next` sits directly under `tag` with no blank line (a speech).
+- (BOOL)tag:(NSString *_Nullable)tag runsInto:(NSString *_Nullable)next;
+@end
+
+@interface ScreenplayUtils : NSObject
+
+// The NSTextList marker prefix a paragraph carries its element in, like the
+// alignment markers: "EnrichedScreenplay:<tag>".
++ (NSString *_Nonnull)markerPrefix;
+// Whether `tag` is a plain slug. A tag is written into an HTML attribute, so
+// nothing else is kept.
++ (BOOL)isValidTag:(NSString *_Nullable)tag;
++ (NSString *_Nonnull)markerForTag:(NSString *_Nonnull)tag;
+// The element tag in a paragraph's text lists, or nil when it carries none
+// (which is action).
++ (NSString *_Nullable)tagFromTextLists:(NSArray<NSTextList *> *_Nullable)lists;
+// Whether the text lists hold a marker that is neither an alignment nor a
+// screenplay element (a list, a quote).
++ (BOOL)textListsHaveForeignMarker:(NSArray<NSTextList *> *_Nullable)lists;
+// `data-sp="tag"` for HTML, or nil for no element.
++ (NSString *_Nullable)htmlAttributeForTextLists:
+    (NSArray<NSTextList *> *_Nullable)lists;
+// The tag in a tag's params string (`data-sp="character"`), or nil.
++ (NSString *_Nullable)tagFromHtmlParams:(NSString *_Nullable)params;
+
+@end
diff --git a/node_modules/react-native-enriched-html/ios/utils/ScreenplayUtils.mm b/node_modules/react-native-enriched-html/ios/utils/ScreenplayUtils.mm
