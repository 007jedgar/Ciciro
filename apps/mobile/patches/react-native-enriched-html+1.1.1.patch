--- /dev/null
+++ b/node_modules/react-native-enriched-html/ios/styles/ScreenplayStyle.mm
@@ -0,0 +1,486 @@
+#import "ScreenplayUtils.h"
+#import "StyleHeaders.h"
+#import "TextListsUtils.h"
+
+// A screenplay element on a paragraph, next to AlignmentStyle.
+//
+// The element rides in the paragraph's NSParagraphStyle.textLists as a marker
+// ("EnrichedScreenplay:<tag>", the way alignment rides as "EnrichedAlignment…"),
+// so it follows the paragraph through every edit the editor already handles
+// (the dirty-range restyling, typing attributes, undo) and round-trips through
+// HTML as `<p data-sp="<tag>">`. The tag is kept as written: a tag this build
+// has no metrics for lays out as action but is never rewritten.
+//
+// What the marker looks like (indents in columns of the editor's monospace
+// face, the blank line between paragraphs, capitals on the keyboard) comes from
+// the app's `screenplay` prop. With no config the style is inert: it only
+// carries markers an HTML load put there. Action has no marker.
+@implementation ScreenplayStyle {
+  ScreenplayConfig *_config;
+  NSString *_configJson;
+
+  // Return pressed with the caret at the end of a paragraph: where, how long
+  // the text was, and the element of that paragraph. Consumed by the change
+  // that follows.
+  BOOL _pendingEnter;
+  BOOL _pendingMidLine;
+  NSUInteger _pendingLocation;
+  NSUInteger _pendingLength;
+  NSString *_pendingTag;
+
+  // The element chosen for the empty line at the very end of the text, where
+  // there is no character to carry a marker (an empty script, or the line a
+  // trailing Return leaves), and the text length it was chosen for.
+  NSString *_trailingTag;
+  NSUInteger _trailingLength;
+}
+
++ (StyleType)getType {
+  return Screenplay;
+}
+
+- (NSString *)getValue {
+  return [ScreenplayUtils markerForTag:@"action"];
+}
+
+- (NSString *)getMarkerPrefix {
+  return [ScreenplayUtils markerPrefix];
+}
+
+- (BOOL)isParagraph {
+  return YES;
+}
+
+- (BOOL)appliesStylingToTyping {
+  return YES;
+}
+
+- (void)toggle:(NSRange)range {
+  // no-op: an element is chosen, not toggled
+}
+
+// MARK: - Config
+
+- (BOOL)isActive {
+  return _config != nil;
+}
+
+- (BOOL)setConfigFromJson:(NSString *)json {
+  NSString *next = json.length > 0 ? json : nil;
+  if ((next == nil && _configJson == nil) || [next isEqualToString:_configJson]) {
+    return NO;
+  }
+  _configJson = [next copy];
+  _config = [ScreenplayConfig configFromJson:next];
+  _trailingTag = nil;
+  _pendingEnter = NO;
+  return YES;
+}
+
+- (BOOL)capsForTag:(NSString *)tag {
+  return _config != nil && [_config metricsForTag:tag].caps;
+}
+
+// MARK: - Reading the element
+
+- (UITextView *)textView {
+  return self.host.textView;
+}
+
+- (NSString *)tagInParagraphStyle:(NSParagraphStyle *)pStyle {
+  return [ScreenplayUtils tagFromTextLists:pStyle.textLists];
+}
+
+// The element of the paragraph that starts at `location` (a paragraph's first
+// character decides, as it does for TextKit), nil for action.
+- (NSString *)tagOfParagraphAt:(NSUInteger)location {
+  NSTextStorage *storage = self.textView.textStorage;
+  if (location >= storage.length) {
+    return nil;
+  }
+  NSParagraphStyle *pStyle = [storage attribute:NSParagraphStyleAttributeName
+                                        atIndex:location
+                                 effectiveRange:nil];
+  return [self tagInParagraphStyle:pStyle];
+}
+
+// Whether `location` is the empty line at the very end of the text: there is
+// no character in it to carry a marker.
+- (BOOL)isTrailingEmptyLineAt:(NSUInteger)location {
+  NSString *string = self.textView.textStorage.string;
+  NSUInteger length = string.length;
+  if (location < length) {
+    return NO;
+  }
+  return length == 0 || [[NSCharacterSet newlineCharacterSet]
+                            characterIsMember:[string characterAtIndex:length - 1]];
+}
+
+// The element of the empty line a text ending in a newline leaves, given the
+// one above it: the one chosen for it, else what Return starts after that.
+- (NSString *)trailingTagAfter:(NSString *)above {
+  NSUInteger textLength = self.textView.textStorage.length;
+  if (_trailingTag != nil && _trailingLength == textLength) {
+    return [_trailingTag isEqualToString:@"action"] ? nil : _trailingTag;
+  }
+  if (textLength == 0) {
+    return nil;
+  }
+  NSString *next = [_config tagAfterEnterFrom:above];
+  return [next isEqualToString:@"action"] ? nil : next;
+}
+
+// The element under the caret; nil for action.
+- (NSString *)tagAtCaret {
+  NSTextStorage *storage = self.textView.textStorage;
+  NSString *text = storage.string;
+  NSUInteger length = text.length;
+  NSUInteger caret = self.textView.selectedRange.location;
+  if (length == 0) {
+    return [self trailingTagAfter:nil];
+  }
+  if (caret >= length) {
+    unichar last = [text characterAtIndex:length - 1];
+    NSRange above = [text paragraphRangeForRange:NSMakeRange(length - 1, 0)];
+    NSString *aboveTag = [self tagOfParagraphAt:above.location];
+    if ([[NSCharacterSet newlineCharacterSet] characterIsMember:last]) {
+      return [self trailingTagAfter:aboveTag];
+    }
+    return aboveTag;
+  }
+  NSRange paragraph = [text paragraphRangeForRange:NSMakeRange(caret, 0)];
+  return [self tagOfParagraphAt:paragraph.location];
+}
+
+- (NSString *)tagNameAtCaret {
+  return [self tagAtCaret] ?: @"action";
+}
+
+- (BOOL)capsAtCaret {
+  return [self capsForTag:[self tagAtCaret]];
+}
+
+// MARK: - Layout
+
+- (CGFloat)columnWidth {
+  UIFont *font = self.host.defaultTypingAttributes[NSFontAttributeName];
+  if (font == nil) {
+    return 0;
+  }
+  return [@"0" sizeWithAttributes:@{NSFontAttributeName : font}].width;
+}
+
+// Indents, alignment and the gap after the paragraph, from the element's
+// metrics. Left alignment stays "natural" so the HTML never grows a
+// text-align it did not have.
+- (void)applyMetricsTo:(NSMutableParagraphStyle *)pStyle
+                   tag:(NSString *)tag
+               nextTag:(NSString *)nextTag {
+  CGFloat column = [self columnWidth];
+  if (_config == nil || column <= 0) {
+    return;
+  }
+  ScreenplayElementMetrics *metrics = [_config metricsForTag:tag];
+  CGFloat left = metrics.indent * column;
+  CGFloat right =
+      MAX(0, _config.columns - metrics.indent - metrics.width) * column;
+  pStyle.firstLineHeadIndent = left;
+  pStyle.headIndent = left;
+  pStyle.tailIndent = right > 0 ? -right : 0;
+  pStyle.alignment =
+      metrics.alignRight ? NSTextAlignmentRight : NSTextAlignmentNatural;
+  pStyle.paragraphSpacing = [_config tag:tag runsInto:nextTag]
+                                ? 0
+                                : [self.host.config scaledParagraphSpacing];
+}
+
+// Lay out the paragraphs `range` touches, and the ones either side of them: the
+// gap under a paragraph depends on the one below it.
+- (void)layoutRange:(NSRange)range {
+  if (_config == nil) {
+    return;
+  }
+  NSTextStorage *storage = self.textView.textStorage;
+  NSString *text = storage.string;
+  NSUInteger length = text.length;
+  if (length == 0) {
+    return;
+  }
+
+  NSUInteger first = MIN(range.location, length - 1);
+  NSUInteger last = MIN(MAX(NSMaxRange(range), 1) - 1, length - 1);
+  last = MAX(last, first);
+
+  NSRange start = [text paragraphRangeForRange:NSMakeRange(first, 0)];
+  if (start.location > 0) {
+    start = [text paragraphRangeForRange:NSMakeRange(start.location - 1, 0)];
+  }
+  NSRange end = [text paragraphRangeForRange:NSMakeRange(last, 0)];
+  NSUInteger limit = NSMaxRange(end);
+  if (limit < length) {
+    limit = NSMaxRange([text paragraphRangeForRange:NSMakeRange(limit, 0)]);
+  }
+
+  BOOL trailingEmptyLine =
+      [[NSCharacterSet newlineCharacterSet]
+          characterIsMember:[text characterAtIndex:length - 1]];
+
+  [storage beginEditing];
+  NSUInteger cursor = start.location;
+  while (cursor < limit && cursor < length) {
+    NSRange paragraph = [text paragraphRangeForRange:NSMakeRange(cursor, 0)];
+    if (paragraph.length == 0) {
+      break;
+    }
+    NSUInteger nextLocation = NSMaxRange(paragraph);
+    NSParagraphStyle *existing =
+        [storage attribute:NSParagraphStyleAttributeName
+                   atIndex:paragraph.location
+            effectiveRange:nil];
+    if (![ScreenplayUtils textListsHaveForeignMarker:existing.textLists]) {
+      NSString *tag = [self tagInParagraphStyle:existing];
+      NSString *nextTag = nil;
+      if (nextLocation < length) {
+        nextTag = [self tagOfParagraphAt:nextLocation];
+      } else if (trailingEmptyLine) {
+        nextTag = [self trailingTagAfter:tag];
+      }
+      NSMutableParagraphStyle *pStyle =
+          [existing mutableCopy]
+              ?: [self.host.defaultTypingAttributes[NSParagraphStyleAttributeName]
+                     mutableCopy]
+              ?: [[NSMutableParagraphStyle alloc] init];
+      [self applyMetricsTo:pStyle tag:tag nextTag:nextTag];
+      if (existing == nil || ![pStyle isEqual:existing]) {
+        [storage addAttribute:NSParagraphStyleAttributeName
+                        value:pStyle
+                        range:paragraph];
+      }
+    }
+    cursor = nextLocation;
+  }
+  [storage endEditing];
+}
+
+- (void)layoutAll {
+  [self layoutRange:NSMakeRange(0, self.textView.textStorage.length)];
+}
+
+// The restyling pass after an edit calls this with the ranges that changed, the
+// empty ones (a deletion) included.
+- (void)refreshLayoutForRanges:(NSArray<NSValue *> *)ranges {
+  if (_config == nil) {
+    return;
+  }
+  for (NSValue *value in ranges) {
+    [self layoutRange:value.rangeValue];
+  }
+}
+
+- (void)applyStyling:(NSRange)range {
+  [self layoutRange:range];
+}
+
+- (void)applyStylingToTypingAttrs:(NSMutableDictionary *)attributes {
+  if (_config == nil) {
+    return;
+  }
+  NSMutableParagraphStyle *pStyle =
+      [attributes[NSParagraphStyleAttributeName] mutableCopy];
+  if (pStyle == nil) {
+    return;
+  }
+  [self applyMetricsTo:pStyle
+                   tag:[self tagInParagraphStyle:pStyle]
+               nextTag:nil];
+  attributes[NSParagraphStyleAttributeName] = pStyle;
+}
+
+// MARK: - Typing
+
+// Make what is typed next belong to the paragraph the caret is in. UIKit takes
+// the typing attributes from the character before the caret, which at the start
+// of a line is the previous line's newline, and the editor drops them to the
+// bare list markers when the caret lands on an empty line.
+- (void)syncTypingAttributes {
+  if (_config == nil) {
+    return;
+  }
+  UITextView *textView = self.textView;
+  if (textView.selectedRange.length > 0 || textView.markedTextRange != nil) {
+    return;
+  }
+  NSString *tag = [self tagAtCaret];
+  NSMutableDictionary *attributes = [textView.typingAttributes mutableCopy];
+  NSMutableParagraphStyle *pStyle =
+      [attributes[NSParagraphStyleAttributeName] mutableCopy]
+          ?: [self.host.defaultTypingAttributes[NSParagraphStyleAttributeName]
+                 mutableCopy]
+          ?: [[NSMutableParagraphStyle alloc] init];
+  NSArray<NSTextList *> *lists =
+      [TextListsUtils textListsByRemovingPrefix:[self getMarkerPrefix]
+                                      fromArray:pStyle.textLists];
+  if (tag != nil) {
+    lists = [lists arrayByAddingObject:[[NSTextList alloc]
+                                           initWithMarkerFormat:
+                                               [ScreenplayUtils markerForTag:tag]
+                                                        options:0]];
+  }
+  pStyle.textLists = lists;
+  [self applyMetricsTo:pStyle tag:tag nextTag:nil];
+  attributes[NSParagraphStyleAttributeName] = pStyle;
+  textView.typingAttributes = attributes;
+}
+
+// MARK: - Choosing an element
+
+// Give the paragraphs `range` touches the element `tag` (action clears it).
+// With an empty range at the very end of the text there is no paragraph to
+// mark, so the choice is remembered for that line.
+- (void)setTag:(NSString *)tag
+      forRange:(NSRange)range
+    withTyping:(BOOL)withTyping {
+  NSString *marked = (tag != nil && [ScreenplayUtils isValidTag:tag] &&
+                      ![tag isEqualToString:@"action"])
+                         ? tag
+                         : nil;
+  NSTextStorage *storage = self.textView.textStorage;
+  NSUInteger length = storage.length;
+
+  if (range.length == 0 && [self isTrailingEmptyLineAt:range.location]) {
+    _trailingTag = marked ?: @"action";
+    _trailingLength = length;
+    if (withTyping && _config != nil) {
+      [self syncTypingAttributes];
+    }
+    [self layoutAll];
+    return;
+  }
+
+  NSRange paragraphs = [self actualUsedRange:range];
+  if (paragraphs.length == 0) {
+    return;
+  }
+  if (marked != nil) {
+    [self add:paragraphs
+             withValue:[ScreenplayUtils markerForTag:marked]
+            withTyping:withTyping
+        withDirtyRange:YES];
+  } else {
+    [self remove:paragraphs withDirtyRange:YES];
+  }
+  [self layoutRange:paragraphs];
+}
+
+// MARK: - Return
+
+// Whether the paragraph `location` sits in has no text: the start of an empty
+// text, a newline right after a newline, or the empty line a text ending in a
+// newline leaves.
+- (BOOL)paragraphIsEmptyAt:(NSUInteger)location {
+  NSString *string = self.textView.textStorage.string;
+  NSUInteger length = string.length;
+  if (length == 0) {
+    return YES;
+  }
+  NSCharacterSet *newlines = [NSCharacterSet newlineCharacterSet];
+  BOOL afterNewline =
+      location == 0 || [newlines characterIsMember:[string characterAtIndex:location - 1]];
+  if (location >= length) {
+    return afterNewline;
+  }
+  return afterNewline && [newlines characterIsMember:[string characterAtIndex:location]];
+}
+
+// Called before a change goes into the text; YES means the Return was handled
+// here and the text must not change. The same rules as the web editor
+// (src/lib/tiptap-screenplay.ts): a Return on an empty line that is not action
+// drops back to action instead of stacking empty elements, a Return splitting
+// speech leaves speech on both sides, and any other Return starts the element
+// that follows the one it ends or splits.
+- (BOOL)noteReplacementInRange:(NSRange)range text:(NSString *)text {
+  _pendingEnter = NO;
+  if (_config == nil) {
+    return NO;
+  }
+  BOOL isReturn = [text isEqualToString:@"\n"];
+  if (isReturn && range.length == 0 && [self paragraphIsEmptyAt:range.location]) {
+    NSString *current = [self tagAtCaret];
+    if (current != nil && [_config knowsTag:current]) {
+      [self setTag:nil forRange:range withTyping:YES];
+      return YES;
+    }
+  }
+  _trailingTag = nil;
+  if (!isReturn) {
+    return NO;
+  }
+  NSString *string = self.textView.textStorage.string;
+  NSUInteger length = string.length;
+  NSUInteger after = NSMaxRange(range);
+  BOOL endsParagraph =
+      after >= length ||
+      [[NSCharacterSet newlineCharacterSet] characterIsMember:[string characterAtIndex:after]];
+  _pendingTag = [self tagAtCaret];
+  _pendingMidLine = !endsParagraph;
+  _pendingLocation = range.location;
+  _pendingLength = length - range.length;
+  _pendingEnter = YES;
+  return NO;
+}
+
+// Called after a change went in. Only a Return in the middle of the text needs
+// work here: at the very end the new line takes its element from
+// `trailingTagAfter:`, whenever it is read.
+- (void)applyPendingEnter {
+  if (!_pendingEnter) {
+    return;
+  }
+  _pendingEnter = NO;
+  if (_config == nil) {
+    return;
+  }
+  NSString *string = self.textView.textStorage.string;
+  if (string.length != _pendingLength + 1 || _pendingLocation >= string.length ||
+      ![[NSCharacterSet newlineCharacterSet]
+          characterIsMember:[string characterAtIndex:_pendingLocation]]) {
+    return;
+  }
+  NSString *next = (_pendingMidLine && [_pendingTag isEqualToString:@"dialogue"])
+                       ? @"dialogue"
+                       : [_config tagAfterEnterFrom:_pendingTag];
+  if ([next isEqualToString:(_pendingTag ?: @"action")]) {
+    return;
+  }
+  NSUInteger newLine = _pendingLocation + 1;
+  if (newLine >= string.length) {
+    return;
+  }
+  [self setTag:next forRange:NSMakeRange(newLine, 0) withTyping:YES];
+}
+
+// MARK: - StyleBase
+
+- (BOOL)styleCondition:(id)value range:(NSRange)range {
+  NSParagraphStyle *pStyle = (NSParagraphStyle *)value;
+  if (pStyle == nil) {
+    return NO;
+  }
+  return [TextListsUtils textLists:pStyle.textLists
+                    containsPrefix:[self getMarkerPrefix]];
+}
+
+- (void)reapplyFromStylePair:(StylePair *)pair {
+  NSRange range = [pair.rangeValue rangeValue];
+  NSParagraphStyle *saved = pair.styleValue;
+  NSString *marker =
+      [TextListsUtils firstTextListWithPrefix:[self getMarkerPrefix]
+                                      inArray:saved.textLists]
+          .markerFormat;
+  if (marker == nil) {
+    return;
+  }
+  [self add:range withValue:marker withTyping:NO withDirtyRange:NO];
+}
+
+@end
