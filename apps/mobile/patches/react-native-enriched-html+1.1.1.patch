+package com.swmansion.enriched.common.spans.interfaces
+
+import android.text.Spanned
+
+interface EnrichedParagraphSpacingSpan {
+  fun paragraphSpacingBelow(
+    text: CharSequence,
+    start: Int,
+    end: Int,
+  ): Int
+
+  companion object {
+    fun below(
+      text: CharSequence?,
+      start: Int,
+      end: Int,
+    ): Int {
+      if (text !is Spanned || end <= start) return 0
+      return text
+        .getSpans(start, end, EnrichedParagraphSpacingSpan::class.java)
+        .maxOfOrNull { it.paragraphSpacingBelow(text, start, end) } ?: 0
+    }
+  }
+}
