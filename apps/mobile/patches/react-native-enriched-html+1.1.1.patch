index 0000000..8667b32
--- /dev/null
+++ b/node_modules/react-native-enriched-html/ios/utils/ScreenplayUtils.mm
@@ -0,0 +1,208 @@
+#import "ScreenplayUtils.h"
+
+static NSString *const kScreenplayMarkerPrefix = @"EnrichedScreenplay:";
+static NSString *const kActionTag = @"action";
+
+@implementation ScreenplayElementMetrics
+@end
+
+@implementation ScreenplayConfig {
+  CGFloat _columns;
+  NSDictionary<NSString *, ScreenplayElementMetrics *> *_elements;
+  NSDictionary<NSString *, NSString *> *_enter;
+  NSSet<NSString *> *_runs;
+}
+
+- (CGFloat)columns {
+  return _columns;
+}
+
+static NSString *runKey(NSString *from, NSString *to) {
+  return [NSString stringWithFormat:@"%@>%@", from, to];
+}
+
++ (instancetype)configFromJson:(NSString *)json {
+  if (json.length == 0) {
+    return nil;
+  }
+  NSData *data = [json dataUsingEncoding:NSUTF8StringEncoding];
+  id parsed = [NSJSONSerialization JSONObjectWithData:data options:0 error:nil];
+  if (![parsed isKindOfClass:[NSDictionary class]]) {
+    return nil;
+  }
+  NSDictionary *root = parsed;
+
+  NSNumber *columns = [root[@"columns"] isKindOfClass:[NSNumber class]]
+                          ? root[@"columns"]
+                          : nil;
+  if (columns == nil || columns.doubleValue <= 0) {
+    return nil;
+  }
+
+  NSMutableDictionary<NSString *, ScreenplayElementMetrics *> *elements =
+      [NSMutableDictionary new];
+  NSDictionary *rawElements =
+      [root[@"elements"] isKindOfClass:[NSDictionary class]] ? root[@"elements"]
+                                                             : @{};
+  for (NSString *tag in rawElements) {
+    NSDictionary *raw = rawElements[tag];
+    if (![ScreenplayUtils isValidTag:tag] ||
+        ![raw isKindOfClass:[NSDictionary class]]) {
+      continue;
+    }
+    ScreenplayElementMetrics *metrics = [ScreenplayElementMetrics new];
+    metrics.indent = [raw[@"indent"] doubleValue];
+    metrics.width = [raw[@"width"] doubleValue];
+    metrics.alignRight = [raw[@"align"] isEqual:@"right"];
+    metrics.caps = [raw[@"caps"] boolValue];
+    elements[tag] = metrics;
+  }
+  if (elements[kActionTag] == nil) {
+    ScreenplayElementMetrics *action = [ScreenplayElementMetrics new];
+    action.indent = 0;
+    action.width = columns.doubleValue;
+    elements[kActionTag] = action;
+  }
+
+  NSMutableDictionary<NSString *, NSString *> *enter = [NSMutableDictionary new];
+  NSDictionary *rawEnter =
+      [root[@"enter"] isKindOfClass:[NSDictionary class]] ? root[@"enter"] : @{};
+  for (NSString *tag in rawEnter) {
+    NSString *next = rawEnter[tag];
+    if ([ScreenplayUtils isValidTag:tag] &&
+        [ScreenplayUtils isValidTag:next]) {
+      enter[tag] = next;
+    }
+  }
