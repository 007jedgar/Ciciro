{
  "expo": {
    "name": "Ciciro",
    "slug": "ciciro",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "ciciro",
    "userInterfaceStyle": "automatic",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://u.expo.dev/fec740f0-4e6e-4c53-8ac5-bc6d448fd1d8",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.ciciro.mobile",
      "usesAppleSignIn": true,
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Ciciro reads a photo only when you choose a file from your photo library to import into a manuscript."
      },
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#141414",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "app.ciciro.mobile",
      "softwareKeyboardLayoutMode": "pan"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#141414",
          "image": "./assets/splash-icon.png"
        }
      ],
      "expo-image",
      "@react-native-community/datetimepicker",
      "expo-dev-client",
      "expo-font",
      "expo-localization",
      [
        "expo-notifications",
        {
          "color": "#b4552d"
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Ciciro uses the microphone so you can dictate your writing.",
          "speechRecognitionPermission": "Ciciro uses speech recognition to turn what you say into text in your chapter."
        }
      ],
      "./plugins/with-ios-scene-lifecycle",
      "expo-sharing",
      [
        "expo-widgets",
        {
          "bundleIdentifier": "app.ciciro.mobile.widgets",
          "groupIdentifier": "group.app.ciciro.mobile",
          "widgets": [
            {
              "name": "WritingDayWidget",
              "displayName": "Writing day",
              "description": "Today’s words, your daily goal, and days written in the last week",
              "ios": {
                "supportedFamilies": [
                  "systemSmall",
                  "systemMedium",
                  "accessoryCircular",
                  "accessoryRectangular",
                  "accessoryInline"
                ]
              }
            }
          ]
        }
      ],
      "expo-web-browser",
      "expo-apple-authentication"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "fec740f0-4e6e-4c53-8ac5-bc6d448fd1d8"
      }
    },
    "owner": "corki"
  }
}
