// Ciciro data model — local-first, single author.
// SQLite keeps everything on the author's machine.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// A hosted account. Auth is email + password (scrypt hash) and/or Sign in
// with Apple or Google (see Identity). Sessions are opaque cookie tokens; only
// the token hash is stored (see Session).
model User {
  id           String @id @default(cuid())
  email        String @unique
  // "" for an account that only signs in with Apple or Google. Kept NOT NULL
  // because D1 can only relax it by rebuilding User, and dropping User there
  // cascade-deletes every Project and Session. See NO_PASSWORD.
  passwordHash String
  name         String @default("")
  // When the account holder proved they receive mail at `email`: Apple or
  // Google vouched for it (social sign-up or link), they clicked a
  // verification link, or they completed a password reset. Null means never.
  // Sign-in never waits on it. See src/lib/auth/verify-email.ts.
  emailVerifiedAt DateTime?
  // The Stripe Customer this account pays through on the web, created by its
  // first Checkout. See src/lib/billing/stripe.ts.
  stripeCustomerId String? @unique

  sessions          Session[]
  identities        Identity[]
  authHandoffs      AuthHandoff[]
  emailTokens       EmailToken[]
  projects          Project[]
  folders           Folder[]
  readingPositions  ReadingPosition[]
  writingDays       WritingDay[]
  writingSessions   WritingSession[]
  passwordAttempts  PasswordAttempt[]
  subscriptions     Subscription[]
  billingEvents     BillingEvent[]
  usageCounters     UsageCounter[]
  pushTokens        PushToken[]
  pushPreference    PushPreference?
  pushNotificationLogs PushNotificationLog[]
  emailPreference   EmailPreference?
  marketingEmailLogs MarketingEmailLog[]

  // JSON blob of synced chrome prefs (theme, editor font, size, autocorrect,
  // chat width). Empty object means defaults. See src/lib/settings.ts.
  settingsJson      String   @default("{}")
  settingsUpdatedAt DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
}

// An authenticated session. `tokenHash` is the SHA-256 of the raw cookie token;
// the raw token never touches the database. Expired rows are swept on lookup.
model Session {
  id        String @id @default(cuid())
  userId    String
  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  tokenHash String   @unique
  userAgent String   @default("")
  expiresAt DateTime

  createdAt DateTime @default(now())

  pushTokens PushToken[]

  @@index([userId])
  @@index([expiresAt])
}

// A Sign in with Apple / Google identity linked to a User. `subject` is the
// provider's stable `sub` claim, so the pair identifies one person for good
// even when their email changes. See src/lib/auth/identity.ts.
model Identity {
  id       String @id @default(cuid())
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider String // "apple" | "google"
  subject  String
  // The email the provider last reported. Informational; linking uses User.email.
  email    String @default("")
  // Apple only: the refresh token from exchanging the authorization code, kept
  // so deleting the account can revoke Ciciro's access (App Store 5.1.1(v)),
  // and the client_id it was issued to (Services ID on the web, bundle ID on
  // iOS), which the revoke call must repeat.
  refreshToken         String @default("")
  refreshTokenClientId String @default("")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([provider, subject])
  @@index([userId])
}

// A one-time hand-off from a browser sign-in back to the phone. The app starts
// the provider flow in a system browser with a PKCE challenge; the callback
// stores the code's hash here and redirects to the app, which redeems the code
// with the matching verifier for a session. Rows live for minutes.
model AuthHandoff {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash  String   @unique
  // base64url SHA-256 of the app's verifier (PKCE S256).
  challenge String
  expiresAt DateTime

  createdAt DateTime @default(now())

  @@index([expiresAt])
}

// A one-time link emailed to an account: verify its address, or reset its
// password. Like Session, only the SHA-256 of the raw token is stored. A link
// is spent (usedAt) rather than deleted so a second click can say "already
// used". Expired rows are swept when the next one is issued. See
// src/lib/auth/email-tokens.ts.
model EmailToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  purpose   String // "verify_email" | "reset_password"
  tokenHash String    @unique
  // The address the link went to. A link only counts for the address it
  // was sent to.
  email     String
  expiresAt DateTime
  usedAt    DateTime?

  createdAt DateTime @default(now())

  @@index([userId, purpose, createdAt])
  @@index([expiresAt])
}

// A phone's Expo push token (ExponentPushToken[...]), registered by the app
// once the author has allowed notifications. It belongs to the sign-in that
// registered it: signing out, or the session expiring, removes it, so a
// shared phone never gets another account's notifications. Registering the
// same token from another sign-in moves it there.
// See src/lib/push/ and docs/mobile-release.md#push-notifications.
model PushToken {
  id        String  @id @default(cuid())
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionId String
  session   Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  token     String  @unique
  platform  String // "ios" | "android"

  tickets PushTicket[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([sessionId])
}

// An Expo push ticket waiting for its receipt. The receipt says whether Apple
// or Google took the notification, and whether the device is gone
// (DeviceNotRegistered, so the token is dropped). Expo keeps receipts for a
// day; checkPushReceipts reads them after 15 minutes and deletes the row.
model PushTicket {
  // The ticket id Expo returned, which is also the receipt id.
  id          String    @id
  pushTokenId String
  pushToken   PushToken @relation(fields: [pushTokenId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([pushTokenId])
  @@index([createdAt])
}

// Per-category opt-out for server-sent push, mirroring EmailPreference's
// shape. Unlike email, there is no separate "opted in" gate: OS permission
// plus a registered PushToken already gate delivery, so a missing row (or a
// missing column default) means every category is on. See
// src/lib/push/preferences.ts.
model PushPreference {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  shareComments Boolean @default(true)
  writingNudge  Boolean @default(true)
  chatFinished  Boolean @default(true)

  updatedAt DateTime @updatedAt

  @@index([userId])
}

// One row per server push actually sent (or attempted), keyed so a retried
// trigger never double-sends (`key` names the specific event, e.g.
// "share-comment:<commentId>", "writing-nudge:<lastWritingDate>",
// "chat-finished:<turnId>") and so sendPushToUser can cap how many of one
// category go to one account in a window (busy comment threads). See
// src/lib/push/send.ts.
model PushNotificationLog {
  id       String @id @default(cuid())
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  category String
  key      String

  createdAt DateTime @default(now())

  @@unique([userId, key])
  @@index([userId, category, createdAt])
}

model Project {
  id       String @id @default(cuid())
  // Owner of the manuscript. Nullable so local-first databases created before
  // hosting/auth keep working; hosted flows always set it on create.
  userId   String?
  owner    User?   @relation(fields: [userId], references: [id], onDelete: Cascade)
  title    String @default("Untitled Manuscript")
  author   String @default("")
  genre    String @default("")
  // What kind of writing this is: novel | screenplay | blog | journal.
  // See src/lib/manuscript-kind.ts. Old rows read as "novel".
  kind     String @default("novel")
  logline  String @default("") // one-sentence hook (the subtitle of a blog post)
  synopsis String @default("") // longer premise
  theme    String @default("") // the throughline the assistant aligns language to
  pov      String @default("") // e.g. "First person, past tense"
  notes    String @default("") // freeform worldbuilding / style notes

  folderId String?
  folder   Folder? @relation(fields: [folderId], references: [id], onDelete: SetNull)

  chapters          Chapter[]
  characters        Character[]
  plotPoints        PlotPoint[]
  messages          ChatMessage[]
  openQuestions     OpenQuestion[]
  chatBlobs         ChatBlob[]
  draftInsertions   DraftInsertion[]
  editorRuns        EditorRun[]
  chapterOps        ChapterOp[]
  bibleFiles        BibleFile[]
  readingPositions  ReadingPosition[]
  manuscriptTarget  ManuscriptTarget?
  chapterSnapshots  ChapterSnapshot[]
  scratchNotes      ScratchNote[]
  recap             ProjectRecap?
  weeklyReviews     WeeklyReview[]
  shareLinks        ShareLink[]
  shareComments     ShareComment[]
  knowledgeFacts    KnowledgeFact[]
  stateProposals    StateProposal[]
  canvasLabels      CanvasLabel[]
  canvasCards       CanvasCard[]
  canvasEdges       CanvasEdge[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, updatedAt])
  @@index([folderId])
}

// A word goal and deadline for one manuscript. Pace is derived from chapter
// word counts (not WritingDay), so falling behind raises tomorrow's number.
model ManuscriptTarget {
  id        String  @id @default(cuid())
  projectId String  @unique
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  wordGoal  Int
  deadline  String // YYYY-MM-DD inclusive

  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}

// A named grouping for an author's manuscripts. Deleting a folder unfiles
// the manuscripts; it does not delete them.
model Folder {
  id     String @id @default(cuid())
  userId String?
  owner  User?  @relation(fields: [userId], references: [id], onDelete: Cascade)

  name  String
  notes String @default("")

  projects Project[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, updatedAt])
}

model Chapter {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  title     String @default("Untitled Chapter")
  order     Int    @default(0)
  content   String @default("") // TipTap HTML
  summary   String @default("") // assistant-maintained beat summary
  status    String @default("draft") // draft | revised | final
  wordCount Int    @default(0)
  revision  Int    @default(0) // optimistic concurrency token for every chapter write
  // Set when the author archives (hides) this chapter. Archived rows stay in
  // the manuscript and can be restored; only empty chapters may be deleted.
  archivedAt DateTime?

  // AI-involvement disclosure (see src/lib/text.ts, docs/tracked-changes.md).
  // Both counters are cumulative and permanent: a word is tallied once, at
  // the moment a Ciciro suggestion is accepted or Ciciro's prose is inserted
  // directly, and a later edit or deletion never moves or removes it. Neither
  // figure is reconstructable from `content` once a suggestion is accepted
  // (acceptance drops the authorship marks), so both are recorded at the
  // point of acceptance/insertion rather than derived later.
  aiAcceptedWords Int @default(0) // words from an accepted Ciciro suggestion
  aiDraftedWords  Int @default(0) // words Ciciro inserted directly (no suggestion to accept)
  // Every word added to the chapter's settled prose by anyone, the same
  // cumulative way (src/lib/chapter-ops.ts): the denominator that makes the
  // Ciciro share a ratio of two running totals rather than of current text.
  wordsAdded      Int @default(0)
  // When these counters started. Defaults to chapter creation for a chapter
  // made after this shipped; for an older chapter the migration backfills it
  // to the migration's run time, so the UI can say the figures only cover
  // activity since then.
  aiInvolvementSince DateTime @default(now())

  plotPoints        PlotPoint[]
  manuscriptEdits   ManuscriptEdit[]
  ops               ChapterOp[]
  readingPositions  ReadingPosition[]
  snapshots         ChapterSnapshot[]
  shareComments     ShareComment[]
  knowledgeFacts    KnowledgeFact[]
  stateProposals    StateProposal[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId, order])
  @@index([projectId, archivedAt])
}

// Append-only block op log. This is the source of truth for a chapter's prose:
// Chapter.content + revision is a cache the log projects onto, and seq equals
// Chapter.revision after a successful apply. `@@unique([chapterId, seq])` is
// what makes that true — claiming seq N is the atomic right to write revision
// N, so two concurrent writers cannot both believe they won (see appendOps).
model ChapterOp {
  id        String  @id @default(cuid())
  chapterId String
  chapter   Chapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  opId         String // client uuid, unique per chapter
  seq          Int    // monotonic per chapter
  baseRevision Int
  actor        String // user | ai | correction — set by the server, never the client
  type         String // replace_block | insert_block | delete_block
  payload      String // JSON of the op fields (blockId, html, afterBlockId, …)
  // Ops written by one authoring action (split, merge, an AI insert) share a
  // groupId and are applied or rejected together. Null for a lone keystroke op.
  groupId      String?
  // Wire format version. Rows written before versioning read as 1.
  v            Int     @default(1)

  createdAt DateTime @default(now())

  @@unique([chapterId, opId])
  @@unique([chapterId, seq])
  @@index([chapterId, seq])
  @@index([projectId, createdAt])
  @@index([chapterId, groupId])
}

// A saved copy of one chapter's prose the author can preview and restore.
// Taken on demand ("manual") and automatically: before the editor's first
// change to text the author last touched ("before_ai"), when the author picks
// a chapter back up after a break ("session", stamped with the time the last
// session ended), and before a restore replaces the text ("before_restore").
// Retention is bounded per chapter; see src/lib/snapshots.ts.
model ChapterSnapshot {
  id        String  @id @default(cuid())
  chapterId String
  chapter   Chapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  kind      String // manual | before_ai | session | before_restore
  label     String @default("") // author's name for a manual snapshot
  content   String // TipTap HTML, block ids included
  wordCount Int    @default(0)
  revision  Int    @default(0) // chapter revision the content was read at
  runId     String? // the editor run or autowrite a before_ai snapshot guards

  createdAt DateTime @default(now())

  @@index([chapterId, createdAt])
  @@index([projectId])
}

// The manuscript's scratchpad: loose notes and research that live beside the
// chapters. Never counted as words, never part of writing-day stats, and never
// exported. Plain text; `revision` guards concurrent edits from two devices.
model ScratchNote {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  title    String @default("")
  content  String @default("")
  revision Int    @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId, updatedAt])
}

// One weekly review of a manuscript: the week's numbers (`stats`, JSON) and
// Ciciro's read on them (`content`, JSON: summary, looseEnds, nextSteps).
// Stored so past reviews can be reread. See src/lib/weekly-review.ts.
model WeeklyReview {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  weekStart String // YYYY-MM-DD, first day covered (device-timezone)
  weekEnd   String // YYYY-MM-DD, last day covered
  stats     String @default("{}")
  content   String @default("{}")

  createdAt DateTime @default(now())

  @@index([projectId, createdAt])
}

// A beta reader link: an unguessable token that opens a read-only view of the
// manuscript (every live chapter) or of the chapters picked in `chapterIds`.
// Revoking is permanent; an expired or revoked link reads exactly like one
// that never existed. See src/lib/shares.ts.
model ShareLink {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  // 256 random bits, base64url. Kept (not hashed) so the author can copy the
  // link again; it grants no more than the prose already in this database.
  token      String    @unique
  label      String    @default("") // who it is for, e.g. "Sam's read"
  // JSON array of chapter ids. Empty means the whole manuscript, including
  // chapters written after the link was made.
  chapterIds String    @default("[]")
  expiresAt  DateTime?
  revokedAt  DateTime?

  comments ShareComment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId, createdAt])
}

// A beta reader's note on a passage of a shared chapter. The passage is the
// quoted text plus where it started (block id and offset into the block's
// visible text), so it can be found again after the author edits around it.
model ShareComment {
  id          String    @id @default(cuid())
  shareLinkId String
  shareLink   ShareLink @relation(fields: [shareLinkId], references: [id], onDelete: Cascade)
  projectId   String
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  chapterId   String
  chapter     Chapter   @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  readerName String
  body       String
  blockId    String
  quote      String
  offset     Int    @default(0)
  // SHA-256 of the link id and the reader's IP, for rate limiting only.
  clientHash String @default("")
  status     String @default("open") // open | resolved
  resolvedAt DateTime?

  createdAt DateTime @default(now())

  @@index([projectId, status, createdAt])
  @@index([shareLinkId, createdAt])
  @@index([shareLinkId, clientHash, createdAt])
  @@index([chapterId])
}

// Story bible markdown, one row per path. Hosted Workers have no filesystem,
// so this is the durable store on D1 (and on local sqlite).
model BibleFile {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  path     String
  content  String
  revision Int      @default(0)
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@unique([projectId, path])
  @@index([projectId])
}

// Durable reading position (chapter + block + offset). LastPlaceTracker on
// mobile stays screen-only; this is the sentence-level cursor.
model ReadingPosition {
  id        String  @id @default(cuid())
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  chapterId String
  chapter   Chapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  blockId String
  offset  Int

  updatedAt DateTime @updatedAt

  @@unique([userId, projectId])
  @@index([projectId])
}

// Per-author daily writing: words added and active typing time. Desk and phone
// heartbeats on the same YYYY-MM-DD merge. A kind weekly target counts days with
// words > 0 in a rolling 7-day window; there is no stored streak to break.
model WritingDay {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  date     String // device-timezone YYYY-MM-DD
  words    Int    @default(0)
  activeMs Int    @default(0)

  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@unique([userId, date])
  @@index([userId])
}

// One continuous sitting at the keys. Starts on the first keystroke and ends
// after five minutes without one (or when a sprint closes). History prefers
// the mean duration of these rows once a few exist; until then it falls back
// to average activeMs per writing day.
model WritingSession {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  projectId String?
  startedAt DateTime
  endedAt   DateTime
  words     Int @default(0)
  activeMs  Int @default(0)

  createdAt DateTime @default(now())

  @@index([userId, startedAt])
}

// A paid subscription, from whichever store sold it. The server is the one
// entitlement authority: Stripe and RevenueCat webhooks both land here after
// re-fetching the subscription from its source, and getEntitlement reads only
// these rows. See src/lib/entitlements.ts and docs/billing.md.
model Subscription {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // "stripe" | "app_store" | "play_store"
  source     String
  // The Stripe subscription id, or "revenuecat:<appUserId>:<productId>".
  externalId String @unique
  productId  String @default("")
  plan       String @default("pro")
  // "month" | "year", or "" when unknown.
  interval   String @default("")
  // Stripe's status words for every source: active, trialing, past_due,
  // canceled, unpaid, incomplete, incomplete_expired, paused, expired.
  status            String
  currentPeriodEnd  DateTime?
  cancelAtPeriodEnd Boolean   @default(false)
  // A store sandbox purchase (TestFlight, App Review, Play license testers).
  sandbox           Boolean   @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

// One processed billing webhook, so a redelivered event is acknowledged
// without running twice. `userId` is set once the event is tied to an account.
model BillingEvent {
  id      String  @id @default(cuid())
  // "stripe" | "revenuecat"
  source  String
  eventId String
  type    String
  userId  String?
  user    User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  receivedAt DateTime @default(now())

  @@unique([source, eventId])
  @@index([userId])
}

// AI use per account per calendar month (UTC), metered against the plan's
// allowance. `period` is "YYYY-MM". See src/lib/entitlements.ts.
model UsageCounter {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  period String
  aiRuns Int    @default(0)

  updatedAt DateTime @updatedAt

  @@unique([userId, period])
}

// The cached "Previously on" recap for one manuscript. `fingerprint` hashes the
// text the recap was written from, so opening the manuscript again without new
// writing reuses the row instead of calling the model.
model ProjectRecap {
  id        String  @id @default(cuid())
  projectId String  @unique
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  content     String
  fingerprint String
  generatedAt DateTime @default(now())
}

// A correction the editor applied via edit_manuscript - the raw find/replace
// pair, kept so the manuscript pane can render a diff of what changed.
model ManuscriptEdit {
  id        String  @id @default(cuid())
  chapterId String
  chapter   Chapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  find    String
  replace String

  createdAt DateTime @default(now())

  @@index([chapterId, createdAt])
}

model Character {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  name        String
  role        String @default("") // protagonist | antagonist | supporting ...
  description String @default("")
  arc         String @default("") // where they start vs. end
  notes       String @default("")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
}

model PlotPoint {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  chapterId String?
  chapter   Chapter? @relation(fields: [chapterId], references: [id], onDelete: SetNull)

  title       String
  description String @default("")
  type        String @default("beat") // setup | payoff | turn | beat | subplot
  status      String @default("open") // open | resolved
  order       Int    @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId, order])
}

model OpenQuestion {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  question    String // the fork the editor did not stop to ask
  provisional String  @default("") // what it went with so it could keep writing
  affects     String  @default("") // where in the manuscript/bible it lands
  chapterId   String? // primary affected chapter, if one
  status      String  @default("open") // open | resolved | dismissed
  answer      String  @default("") // the author's answer, once given
  resolution  String  @default("") // what the editor changed on reconciliation

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId, status])
}

model ChatMessage {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  role         String // user | assistant
  content      String
  // Cached model-facing view (stubs for oversized / aged content). Null means
  // the model still sees `content` (minus any inserted-draft stubs applied live).
  modelContent String?
  kind         String    @default("chat") // chat | action | autowrite | compact | reconcile
  // Groups a user turn with its assistant reply so the client can resume after
  // a dropped stream without re-sending the author's message.
  turnId       String?
  // complete = verified finished; continuing = durable run has more work;
  // partial = legacy/interrupted reply; compact = rolled-up prior context;
  // archived = soft-archived by automatic compaction (still readable via
  // read_past_turn / search_chat).
  status       String    @default("complete")
  // Set when automatic compaction rolls this row out of the live window.
  // Clear-chat hard-deletes regardless; UI/model windows exclude archived rows.
  archivedAt   DateTime?

  createdAt DateTime @default(now())

  @@index([projectId, createdAt])
  @@index([projectId, turnId])
  @@index([projectId, archivedAt])
}

// Durable execution state for one author turn. `turnId` is the external
// idempotency key; messagesJson is the authoritative in-run model transcript.
model EditorRun {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  turnId             String  @unique
  userMessageId      String?
  assistantMessageId String?
  kind               String  @default("chat")
  scope              String?
  activeChapterId    String?
  selection          String  @default("")
  autoMode           Boolean @default(false)

  status           String  @default("queued") // queued | running | continuing | verifying | completed | failed | cancelled
  messagesJson     String  @default("[]")
  visibleOutput    String  @default("")
  iterationCount   Int     @default(0)
  mutationCount    Int     @default(0)
  stopReason       String?
  verificationJson String?
  error            String?

  lockToken      String?
  leaseExpiresAt DateTime?
  startedAt      DateTime?
  completedAt    DateTime?
  cancelledAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  steps EditorStep[]

  @@index([projectId, createdAt])
  @@index([projectId, status])
}

// Append-only checkpoint for one model iteration. Model response and tool
// results are serialized separately for inspection; EditorRun.messagesJson
// stores the resumable transcript after the iteration.
model EditorStep {
  id    String    @id @default(cuid())
  runId String
  run   EditorRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  iteration         Int
  status            String
  stopReason        String?
  modelResponseJson String
  toolResultsJson   String?
  visibleDelta      String   @default("")
  mutationCount     Int      @default(0)
  startedAt         DateTime @default(now())
  finishedAt        DateTime @default(now())

  @@unique([runId, iteration])
  @@index([runId, startedAt])
}

// Chat-only payloads with no other durable home (tool results, freeform
// excerpts, rolled transcripts). Inserted drafts point at Chapter instead.
model ChatBlob {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  kind      String // tool_result | chat_excerpt | transcript
  content   String
  charCount Int     @default(0)
  label     String  @default("") // one-line gist shown in stubs
  messageId String?
  turnId    String?

  createdAt DateTime @default(now())

  @@index([projectId, createdAt])
  @@index([projectId, turnId])
}

// Author-approved paste of a chat <draft> into the manuscript. Keyed by
// (turnId, segmentIndex) so it survives streaming temp ids and page reloads.
model DraftInsertion {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  turnId       String
  segmentIndex Int
  chapterId    String

  createdAt DateTime @default(now())

  @@unique([turnId, segmentIndex])
  @@index([projectId])
  @@index([turnId])
}

// One failed sign-in or account-deletion password attempt, for the shared
// rate limiter (src/lib/auth/rate-limit.ts). A window's worth of rows is
// counted per key; a success clears its key's rows. `key` is the normalized
// email for a login attempt (an account need not exist yet to be counted, so
// a guess against an unregistered address is throttled the same way — no
// enumeration signal) or the userId for a deletion attempt. `userId` is set
// only when the attempt is tied to a real account (deletion always; login
// only via the email match in purgeAccountData), so account deletion purges
// every row it owns without relying on cascades. `ipHash` is
// sha256(scope + address); the address itself is never stored.
model PasswordAttempt {
  id     String  @id @default(cuid())
  scope  String // "login" | "delete"
  key    String
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)
  ipHash String

  createdAt DateTime @default(now())

  @@index([scope, key, createdAt])
  @@index([ipHash, createdAt])
  @@index([createdAt])
  @@index([userId])
}

// Marketing-email consent: the single opt-in checkbox plus the topics it
// unlocks. One row per user, created the first time marketingOptIn turns on
// (signup, or Settings); no row means "never opted in" (every send is
// gated off). Ciciro owns this, not Resend, so account deletion and export
// cover it (see docs/account-data.md). `unsubscribeToken` keys the public,
// no-session preferences page and the one-click List-Unsubscribe link every
// marketing email carries (src/lib/email/preferences.ts) — not a security
// credential, so it is a plain id, not hashed.
model EmailPreference {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  marketingOptIn   Boolean   @default(false)
  marketingOptInAt DateTime?
  productUpdates   Boolean   @default(true)
  weeklyEmail      Boolean   @default(true)
  offers           Boolean   @default(true)

  unsubscribeToken String @unique

  updatedAt DateTime @updatedAt

  @@index([userId])
}

// One row per marketing email actually sent to an account: idempotency (a
// cron run that fires twice, or is retried, must never repeat a send) and a
// record support can read. `key` names the specific send — a welcome-
// sequence step ("welcome-2"), an allowance-nudge period
// ("allowance-nudge:2026-03"), or one changelog entry ("changelog:<entryId>",
// also used to tell which docs/CHANGELOG.md entries have ever been announced
// to anyone — see src/lib/email/cron.ts). See src/lib/email/marketing-send.ts.
model MarketingEmailLog {
  id     String   @id @default(cuid())
  userId String
  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  key    String
  sentAt DateTime @default(now())

  @@unique([userId, key])
  @@index([userId])
  @@index([key])
}

// What a character knows or believes, and the chapter that made it true.
// The table is the source of truth. A mirror block in characters/<slug>.md
// (between knows:start and knows:end) is rewritten whenever a fact changes,
// so read_bible and a person opening the file see the same ledger.
// See src/lib/knowledge.ts.
model KnowledgeFact {
  id            String   @id @default(cuid())
  projectId     String
  project       Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  // characters/<slug>.md. Character rows are not the source of truth.
  characterPath String
  fact          String
  stance        String // knows | believes
  chapterId     String?
  chapter       Chapter? @relation(fields: [chapterId], references: [id], onDelete: SetNull)
  sourceQuote   String   @default("")
  status        String   @default("active") // active | superseded

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId, characterPath, status])
  @@index([chapterId])
}

// A chapter-close proposal the author dismissed. The next review skips a
// proposal whose fingerprint (chapterId, kind, normalized text) is already here.
model StateProposal {
  id          String  @id @default(cuid())
  projectId   String
  project     Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  chapterId   String
  chapter     Chapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  kind        String // canon | timeline | plot | knowledge
  fingerprint String
  text        String  @default("")

  createdAt DateTime @default(now())

  @@unique([projectId, fingerprint])
  @@index([projectId, chapterId])
}

// A label the author made for the planning canvas. Color is one of a fixed set
// (src/lib/canvas-view.ts). The model never creates these.
model CanvasLabel {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name      String
  color     String
  cards     CanvasCardLabel[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([projectId, name])
  @@index([projectId])
}

// One card on the planning canvas. Positions are world coordinates, saved when
// a drag ends. Generated text stays here; it is never a chapter.
model CanvasCard {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title     String  @default("")
  body      String  @default("")
  x         Float   @default(0)
  y         Float   @default(0)

  labels    CanvasCardLabel[]
  edgesFrom CanvasEdge[] @relation("CanvasEdgeFrom")
  edgesTo   CanvasEdge[] @relation("CanvasEdgeTo")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
}

model CanvasCardLabel {
  id      String      @id @default(cuid())
  cardId  String
  card    CanvasCard  @relation(fields: [cardId], references: [id], onDelete: Cascade)
  labelId String
  label   CanvasLabel @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@unique([cardId, labelId])
  @@index([labelId])
}

model CanvasEdge {
  id        String     @id @default(cuid())
  projectId String
  project   Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  fromId    String
  from      CanvasCard @relation("CanvasEdgeFrom", fields: [fromId], references: [id], onDelete: Cascade)
  toId      String
  to        CanvasCard @relation("CanvasEdgeTo", fields: [toId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([fromId, toId])
  @@index([projectId])
  @@index([toId])
}
