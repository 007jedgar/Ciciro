// Ciciro data model — local-first, single author.
// SQLite keeps everything on the author's machine.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// A hosted account. Auth is email + password (scrypt hash). Sessions are
// opaque cookie tokens; only the token hash is stored (see Session).
model User {
  id           String @id @default(cuid())
  email        String @unique
  passwordHash String
  name         String @default("")

  sessions Session[]
  projects Project[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
}

// An authenticated session. `tokenHash` is the SHA-256 of the raw cookie token;
// the raw token never touches the database. Expired rows are swept on lookup.
model Session {
  id        String @id @default(cuid())
  userId    String
  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  tokenHash String   @unique
  userAgent String   @default("")
  expiresAt DateTime

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model Project {
  id       String @id @default(cuid())
  // Owner of the manuscript. Nullable so local-first databases created before
  // hosting/auth keep working; hosted flows always set it on create.
  userId   String?
  owner    User?   @relation(fields: [userId], references: [id], onDelete: Cascade)
  title    String @default("Untitled Manuscript")
  author   String @default("")
  genre    String @default("")
  logline  String @default("") // one-sentence hook
  synopsis String @default("") // longer premise
  theme    String @default("") // the throughline the assistant aligns language to
  pov      String @default("") // e.g. "First person, past tense"
  notes    String @default("") // freeform worldbuilding / style notes

  chapters        Chapter[]
  characters      Character[]
  plotPoints      PlotPoint[]
  messages        ChatMessage[]
  openQuestions   OpenQuestion[]
  chatBlobs       ChatBlob[]
  draftInsertions DraftInsertion[]
  editorRuns      EditorRun[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, updatedAt])
}

model Chapter {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  title     String @default("Untitled Chapter")
  order     Int    @default(0)
  content   String @default("") // TipTap HTML
  summary   String @default("") // assistant-maintained beat summary
  status    String @default("draft") // draft | revised | final
  wordCount Int    @default(0)
  revision  Int    @default(0) // optimistic concurrency token for every chapter write

  plotPoints      PlotPoint[]
  manuscriptEdits ManuscriptEdit[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId, order])
}

// A correction the editor applied via edit_manuscript - the raw find/replace
// pair, kept so the manuscript pane can render a diff of what changed.
model ManuscriptEdit {
  id        String  @id @default(cuid())
  chapterId String
  chapter   Chapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  find    String
  replace String

  createdAt DateTime @default(now())

  @@index([chapterId, createdAt])
}

model Character {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  name        String
  role        String @default("") // protagonist | antagonist | supporting ...
  description String @default("")
  arc         String @default("") // where they start vs. end
  notes       String @default("")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
}

model PlotPoint {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  chapterId String?
  chapter   Chapter? @relation(fields: [chapterId], references: [id], onDelete: SetNull)

  title       String
  description String @default("")
  type        String @default("beat") // setup | payoff | turn | beat | subplot
  status      String @default("open") // open | resolved
  order       Int    @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId, order])
}

model OpenQuestion {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  question    String // the fork the editor did not stop to ask
  provisional String  @default("") // what it went with so it could keep writing
  affects     String  @default("") // where in the manuscript/bible it lands
  chapterId   String? // primary affected chapter, if one
  status      String  @default("open") // open | resolved | dismissed
  answer      String  @default("") // the author's answer, once given
  resolution  String  @default("") // what the editor changed on reconciliation

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId, status])
}

model ChatMessage {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  role         String // user | assistant
  content      String
  // Cached model-facing view (stubs for oversized / aged content). Null means
  // the model still sees `content` (minus any inserted-draft stubs applied live).
  modelContent String?
  kind         String    @default("chat") // chat | action | autowrite | compact | reconcile
  // Groups a user turn with its assistant reply so the client can resume after
  // a dropped stream without re-sending the author's message.
  turnId       String?
  // complete = verified finished; continuing = durable run has more work;
  // partial = legacy/interrupted reply; compact = rolled-up prior context;
  // archived = soft-archived by automatic compaction (still readable via
  // read_past_turn / search_chat).
  status       String    @default("complete")
  // Set when automatic compaction rolls this row out of the live window.
  // Clear-chat hard-deletes regardless; UI/model windows exclude archived rows.
  archivedAt   DateTime?

  createdAt DateTime @default(now())

  @@index([projectId, createdAt])
  @@index([projectId, turnId])
  @@index([projectId, archivedAt])
}

// Durable execution state for one author turn. `turnId` is the external
// idempotency key; messagesJson is the authoritative in-run model transcript.
model EditorRun {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  turnId             String  @unique
  userMessageId      String?
  assistantMessageId String?
  kind               String  @default("chat")
  scope              String?
  activeChapterId    String?
  selection          String  @default("")
  autoMode           Boolean @default(false)

  status           String  @default("queued") // queued | running | continuing | verifying | completed | failed | cancelled
  messagesJson     String  @default("[]")
  visibleOutput    String  @default("")
  iterationCount   Int     @default(0)
  mutationCount    Int     @default(0)
  stopReason       String?
  verificationJson String?
  error            String?

  lockToken      String?
  leaseExpiresAt DateTime?
  startedAt      DateTime?
  completedAt    DateTime?
  cancelledAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  steps EditorStep[]

  @@index([projectId, createdAt])
  @@index([projectId, status])
}

// Append-only checkpoint for one model iteration. Model response and tool
// results are serialized separately for inspection; EditorRun.messagesJson
// stores the resumable transcript after the iteration.
model EditorStep {
  id    String    @id @default(cuid())
  runId String
  run   EditorRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  iteration         Int
  status            String
  stopReason        String?
  modelResponseJson String
  toolResultsJson   String?
  visibleDelta      String   @default("")
  mutationCount     Int      @default(0)
  startedAt         DateTime @default(now())
  finishedAt        DateTime @default(now())

  @@unique([runId, iteration])
  @@index([runId, startedAt])
}

// Chat-only payloads with no other durable home (tool results, freeform
// excerpts, rolled transcripts). Inserted drafts point at Chapter instead.
model ChatBlob {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  kind      String // tool_result | chat_excerpt | transcript
  content   String
  charCount Int     @default(0)
  label     String  @default("") // one-line gist shown in stubs
  messageId String?
  turnId    String?

  createdAt DateTime @default(now())

  @@index([projectId, createdAt])
  @@index([projectId, turnId])
}

// Author-approved paste of a chat <draft> into the manuscript. Keyed by
// (turnId, segmentIndex) so it survives streaming temp ids and page reloads.
model DraftInsertion {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  turnId       String
  segmentIndex Int
  chapterId    String

  createdAt DateTime @default(now())

  @@unique([turnId, segmentIndex])
  @@index([projectId])
  @@index([turnId])
}
