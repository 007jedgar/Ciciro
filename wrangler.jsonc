{
  // Cloudflare deployment for the hosted Ciciro app (Next.js via OpenNext).
  //
  // Build + deploy:
  //   npm run cf:build     # next build -> .open-next/worker.js
  //   npm run cf:preview   # local wrangler preview
  //   npm run cf:deploy    # wrangler deploy
  //
  // Workers Builds still calls `npm run build` then `wrangler versions upload`.
  // That script runs the OpenNext adapter when WORKERS_CI=1 so `.open-next/assets`
  // exists for the upload. Do not point CI at a plain `next build`.
  //
  // `main` is a thin custom entry (src/worker/index.ts) that wraps the
  // OpenNext-generated worker and also exports the Durable Object classes.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ciciro",
  "main": "src/worker/index.ts",
  "compatibility_date": "2025-08-01",
  "compatibility_flags": ["nodejs_compat", "nodejs_compat_populate_process_env"],
  "workers_dev": true,

  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },

  // One Durable Object class, two bindings. Editor runs are keyed by run id;
  // chapter pokes are keyed by project id. A second sqlite class cannot be
  // created by Workers Builds (`wrangler versions upload`); poke traffic
  // therefore uses the existing EditorRunDO class (see src/worker/run-do.ts).
  "durable_objects": {
    "bindings": [
      {
        "name": "EDITOR_RUN_DO",
        "class_name": "EditorRunDO"
      },
      {
        "name": "PROJECT_POKE_DO",
        "class_name": "EditorRunDO"
      }
    ]
  },

  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["EditorRunDO"]
    }
  ],

  "observability": {
    "enabled": true
  },

  // Daily at 14:00 UTC: src/worker/index.ts's `scheduled` handler runs the
  // welcome sequence and (Mondays only) the changelog digest. See
  // src/lib/email/cron.ts.
  "triggers": {
    "crons": ["0 14 * * *"]
  },

  "vars": {
    "CICIRO_REQUIRE_AUTH": "true"
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ciciro",
      "database_id": "b8b60772-8cdd-4647-a8f5-bfe8873b1a5d"
    }
  ],

  // Public product hostnames. Cloudflare creates DNS + certificates for these
  // when the zone lives on the same account as this Worker.
  "routes": [
    { "pattern": "ciciro.app", "custom_domain": true },
    { "pattern": "www.ciciro.app", "custom_domain": true }
  ]

  // Secrets (set with `wrangler secret put <NAME>`), not committed:
  //   ANTHROPIC_API_KEY      - required for the editor/drafter models
  //   RESEND_API_KEY         - transactional email; unset logs instead of sending
  //   EMAIL_FROM             - "Name <address>" the send comes from
  //   EMAIL_REPLY_TO         - optional reply-to override
  //   MARKETING_EMAIL_FROM   - marketing sends' "Name <address>"; falls back to
  //                            EMAIL_FROM if unset (see docs/hosting.md#email)
  //   CICIRO_PUBLIC_URL      - required for the scheduled handler above, which
  //                            has no request to read an origin from
  //   EXPO_ACCESS_TOKEN      - optional; Expo Push API token once enhanced push
  //                            security is on (docs/mobile-release.md)
  // Hosted auth/session data lives in the D1 binding above, not DATABASE_URL.
}
