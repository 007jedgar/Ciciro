# Copy to .env and fill in.

# Anthropic API key for the Ciciro writing assistant.
# Get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Local SQLite database (default is fine for single-author local use).
DATABASE_URL="file:./dev.db"

# Models. The EDITOR is the one you talk to (planning, decisions, critique).
# The DRAFTER writes the actual prose from the editor's briefs, behind the scenes.
CICIRO_EDITOR_MODEL=claude-opus-5
CICIRO_DRAFTER_MODEL=claude-sonnet-5
# Used when the editor asks for a "fast" rough draft.
# Also used for continuity compaction and chapter summaries (Haiku only).
CICIRO_DRAFTER_FAST_MODEL=claude-haiku-4-5

# Optional. When set, a cheap Groq model may rank/suggest chat-search candidates.
# Advisory only - the editor (Opus) always decides what to open. Haiku is used
# if this is unset or Groq errors. Continuity compaction never uses Groq.
# GROQ_API_KEY=
# CICIRO_ROUTER_MODEL=llama-3.1-8b-instant
