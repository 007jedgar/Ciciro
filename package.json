{
  "name": "ciciro",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "Ciciro — an AI book-writing assistant and manuscript editor",
  "scripts": {
    "dev": "node scripts/generate-changelog-data.ts && next dev",
    "build": "node scripts/build.mjs",
    "changelog:generate": "node scripts/generate-changelog-data.ts",
    "test": "node run-vitest.mjs",
    "start": "next start",
    "lint": "next lint",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "db:check:d1": "node scripts/check-d1-schema.mjs",
    "setup": "prisma generate && prisma db push",
    "typecheck": "tsc --noEmit",
    "higgsfield:example": "node --env-file-if-exists=.env.local scripts/higgsfield/index.ts",
    "demo:craft": "node --env-file-if-exists=.env.local scripts/craft-demo/run.mjs",
    "typecheck:worker": "tsc --noEmit -p tsconfig.worker.json",
    "typecheck:mobile": "npm run typecheck --prefix apps/mobile",
    "test:mobile": "npm test --prefix apps/mobile",
    "mobile:start": "npm run start --prefix apps/mobile",
    "cf:build": "node scripts/generate-changelog-data.ts && prisma generate && opennextjs-cloudflare build",
    "cf:preview": "npm run cf:build && opennextjs-cloudflare preview",
    "cf:deploy": "npm run db:check:d1 && npm run cf:build && opennextjs-cloudflare deploy"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "@higgsfield/client": "^0.2.6",
    "@prisma/adapter-d1": "^6.1.0",
    "@prisma/client": "^6.1.0",
    "@react-email/body": "^0.3.0",
    "@react-email/button": "^0.2.1",
    "@react-email/column": "^0.0.14",
    "@react-email/container": "^0.0.16",
    "@react-email/head": "^0.0.13",
    "@react-email/heading": "^0.0.16",
    "@react-email/hr": "^0.0.12",
    "@react-email/html": "^0.0.12",
    "@react-email/img": "^0.0.12",
    "@react-email/link": "^0.0.13",
    "@react-email/preview": "^0.0.14",
    "@react-email/row": "^0.0.13",
    "@react-email/section": "^0.0.17",
    "@react-email/text": "^0.1.6",
    "@tiptap/extension-character-count": "^2.11.0",
    "@tiptap/extension-placeholder": "^2.11.0",
    "@tiptap/pm": "^2.11.0",
    "@tiptap/react": "^2.11.0",
    "@tiptap/starter-kit": "^2.11.0",
    "diff": "^9.0.0",
    "docx": "^9.1.0",
    "esbuild": "^0.28.2",
    "fflate": "^0.8.3",
    "jose": "^6.2.12",
    "jszip": "^3.10.2",
    "next": "^15.1.0",
    "pdf-lib": "^1.17.1",
    "posthog-js": "^1.435.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "stripe": "^22.6.2"
  },
  "allowScripts": {
    "esbuild": true,
    "@prisma/client": true,
    "@prisma/engines": true,
    "prisma": true,
    "sharp": true,
    "unrs-resolver": true,
    "workerd": true
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260901.1",
    "@eslint/eslintrc": "^3.2.0",
    "@opennextjs/cloudflare": "^1.20.5",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.17.0",
    "eslint-config-next": "^15.1.0",
    "jsdom": "^30.0.1",
    "prisma": "^6.1.0",
    "sharp": "^0.34.5",
    "typescript": "^5.7.0",
    "vitest": "^4.1.10",
    "wrangler": "^4.127.1"
  }
}
